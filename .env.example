# Paper mode is the default. Nothing in this file moves funds.
# Copy to .env if you want optional settings. Never commit .env.

PORT=8787

# Public NEAR RPC used to read v1.signer derived addresses. Read-only.
NEAR_RPC_URL=https://rpc.mainnet.near.org

# NEAR Intents 1Click. Paper cycles always send dry: true.
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# Optional partner JWT. Without it, 1Click adds a small unauthenticated fee.
# Register at https://partners.near-intents.org. Leave empty for the demo.
# ONECLICK_JWT=

# Optional memo rewrite. The policy decides the trade either way.
# Key from https://cloud.near.ai (or the NEAR Builders $10 key).
# NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.2

# Optional OpenAI-compatible fallback, used only when NEAR_AI_API_KEY is empty.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Live mode is off. Uncommenting both lines still does not broadcast a
# transaction. It only allows POST /api/live-quote to ask 1Click for a
# deposit address (dry: false). You would have to send funds yourself.
# FUND_AGENT_MODE=live
# FUND_AGENT_CONFIRM_LIVE=yes
